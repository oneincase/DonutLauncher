{
  "name": "DonutLauncher",
  "version": "0.0.1",
  "description": "甜甜圈启动台 - macOS 圆形应用启动器",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "reset": "electron . --reset-settings",
    "test": "node --test \"src/**/*.test.js\"",
    "verify": "electron tools/verify-screenshot.js",
    "measure": "electron tools/measure-resources.js",
    "build:mac": "electron-builder --mac dmg"
  },
  "keywords": [
    "electron",
    "macos",
    "launcher",
    "donut"
  ],
  "author": "oneincase <462534624@qq.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "icns-lib": "^1.0.1"
  },
  "build": {
    "appId": "com.github.oneincase.DonutLauncher",
    "productName": "甜甜圈启动台",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "oneincase",
        "repo": "DonutLauncher"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "title": "甜甜圈启动台"
    }
  }
}
