  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@tauri-apps/cli": "^2.5.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "typescript": "^5.8.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.0",
    "vue-tsc": "^2.2.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0"
  }
