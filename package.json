{
  "name": "DonutLauncher",
  "version": "1.0.5",
  "description": "甜甜圈启动台 - macOS 圆形应用启动器",
  "scripts": {
    "dev": "tauri dev",
    "start": "tauri dev",
    "build": "tauri build",
    "web:dev": "vite",
    "web:build": "vue-tsc --noEmit && vite build",
    "web:preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "pnpm test:web && pnpm test:rust",
    "test:web": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "verify": "playwright test",
    "verify:web": "playwright test"
  },
  "keywords": [
    "tauri",
    "macos",
    "launcher",
    "donut"
  ],
  "author": "oneincase <462534624@qq.com>",
